# =============================================================================
# Crypto Trading Bot - Environment Configuration
# =============================================================================
# Professional crypto trading bot with Flask backend, DeepSeek V4 AI integration,
# Binance API, multi-timeframe technical analysis, chat intelligence, and
# beautiful dark trading terminal UI
# =============================================================================

# ---------------------------------------------------------------------------
# DeepSeek V4 AI Configuration
# ---------------------------------------------------------------------------
# Your DeepSeek V4 API key for AI-powered trading analysis and chat intelligence
# Get your key from: https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ---------------------------------------------------------------------------
# Binance API Configuration
# ---------------------------------------------------------------------------
# Binance API credentials for trading operations
# Generate from: https://www.binance.com/en/support/faq/how-to-create-api-keys-on-binance-360002502072
# IMPORTANT: Enable only the necessary permissions (read, trade) for security
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# ---------------------------------------------------------------------------
# Flask Application Configuration
# ---------------------------------------------------------------------------
# Secret key for Flask session management and CSRF protection
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_flask_secret_key_here

# Flask environment mode
# Options:
#   development - Enables debug mode, detailed error messages, hot reload
#   production  - Disables debug mode, optimized for deployment
#   testing     - Used for automated testing
FLASK_ENV=development

# ---------------------------------------------------------------------------
# Optional: Database Configuration (if using persistent storage)
# ---------------------------------------------------------------------------
# DATABASE_URL=sqlite:///trading_bot.db
# DATABASE_URL=postgresql://user:password@localhost:5432/trading_bot

# ---------------------------------------------------------------------------
# Optional: Redis Configuration (for caching and rate limiting)
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Optional: Logging Configuration
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FILE=logs/trading_bot.log

# ---------------------------------------------------------------------------
# Optional: Trading Parameters (overrides defaults)
# ---------------------------------------------------------------------------
# MAX_POSITION_SIZE=1000
# STOP_LOSS_PERCENTAGE=2.0
# TAKE_PROFIT_PERCENTAGE=4.0
# MAX_OPEN_TRADES=5

# ---------------------------------------------------------------------------
# Optional: WebSocket Configuration
# ---------------------------------------------------------------------------
# BINANCE_WS_URL=wss://stream.binance.com:9443/ws
# BINANCE_WS_STREAMS=btcusdt@trade,btcusdt@kline_1m

# ---------------------------------------------------------------------------
# Optional: Security Settings
# ---------------------------------------------------------------------------
# ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
# RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Optional: Email Notifications (for alerts)
# ---------------------------------------------------------------------------
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# ALERT_EMAIL=your_email@gmail.com

# ---------------------------------------------------------------------------
# Optional: Telegram Bot Notifications
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# =============================================================================
# IMPORTANT SECURITY NOTES:
# =============================================================================
# 1. NEVER commit this file to version control with real credentials
# 2. Use .env file locally and set environment variables in production
# 3. Rotate API keys regularly
# 4. Use Binance API keys with IP whitelisting when possible
# 5. Enable 2FA on all accounts
# 6. Store secrets in a secure vault in production (e.g., HashiCorp Vault)
# =============================================================================